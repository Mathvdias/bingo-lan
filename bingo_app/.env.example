# Copie para .env (ignorado pelo git) e preencha.
# Chaves públicas de SDK do RevenueCat (goog_... / appl_...)
RC_ANDROID_KEY=
RC_IOS_KEY=
# RevenueCat Test Store (test_...). Só é usada no flavor dev; quando preenchida,
# substitui as chaves acima e o paywall mostra os pacotes de teste
# ($rc_monthly / $rc_annual / $rc_lifetime) sem precisar de produtos na Play.
RC_TEST_STORE_KEY=
