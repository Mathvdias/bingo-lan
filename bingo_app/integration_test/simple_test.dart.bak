import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:integration_test/integration_test.dart';

import 'package:bingo_app/main_dev.dart' as app_entry;

void main() {
  IntegrationTestWidgetsFlutterBinding.ensureInitialized();

  group('Simple E2E', () {
    testWidgets('app startup test', (tester) async {
      // Iniciar o app
      app_entry.main();
      await tester.pumpAndSettle();

      // Esperar um pouco para o splash
      await tester.pump(const Duration(seconds: 3));
      await tester.pumpAndSettle();

      // Verificar se o app está rodando (qualquer widget)
      expect(find.byType(MaterialApp), findsAtLeastNWidgets(1));
      
      // Teste simples de interação
      await tester.pump(const Duration(seconds: 1));
      await tester.pumpAndSettle();
      
      // Finalizar teste
      expect(true, isTrue);
    });
  });
}
